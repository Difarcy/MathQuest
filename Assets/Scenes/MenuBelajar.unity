--- !u!114 &1617866169
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1617866167}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "FPB PADA PEMBAGIAN BENDA\r\n\r\nFPB dapat digunakan untuk menentukan banyak
    kelompok paling banyak apabila setiap kelompok harus berisi jumlah yang sama
    dari setiap jenis benda, tanpa sisa.\r\n\r\nContoh: Tersedia 24 mawar merah dan
    18 mawar putih. Semua bunga akan dibagi ke dalam beberapa vas. Jumlah mawar merah
    harus sama pada setiap vas. Begitu pula jumlah mawar putihnya. Berapa vas paling
    banyak?\r\n\r\n24 = 2\xB3 \xD7 3\r\n18 = 2 \xD7 3\xB2\r\n\r\nPilih faktor prima
    yang sama dengan pangkat terkecil:\r\nFPB = 2 \xD7 3 = 6.\r\n\r\nJadi, bunga
    dapat dibagikan ke paling banyak 6 vas."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 139f41658187fe8468598371f870f595, type: 2}
  m_sharedMaterial: {fileID: 3673575472737202838, guid: 139f41658187fe8468598371f870f595, type: 2}
