  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "PENGERTIAN FAKTOR BILANGAN\r\n\r\nFaktor suatu bilangan adalah bilangan
    asli yang dapat membagi habis bilangan tersebut tanpa sisa.\r\n\r\nContoh: Faktor
    dari 12.\r\n\r\n12 \xF7 1 = 12\r\n12 \xF7 2 = 6\r\n12 \xF7 3 = 4\r\n\r\nSetiap
    pembagi dan hasil baginya membentuk pasangan faktor: (1, 12), (2, 6), dan (3,
    4).\r\n\r\nSebaliknya, 5 bukan faktor dari 12 karena 12 \xF7 5 menghasilkan sisa
    2.\r\n\r\nJadi, faktor dari 12 adalah 1, 2, 3, 4, 6, dan 12."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 139f41658187fe8468598371f870f595, type: 2}
  m_sharedMaterial: {fileID: 3673575472737202838, guid: 139f41658187fe8468598371f870f595, type: 2}
