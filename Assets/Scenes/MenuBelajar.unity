  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "MENENTUKAN FAKTOR DENGAN PERKALIAN\r\n\r\nFaktor juga dapat ditentukan
    melalui pasangan bilangan yang hasil perkaliannya sama dengan bilangan yang dicari.\r\n\r\nContoh:
    Faktor dari 18.\r\n\r\n1 \xD7 18 = 18\r\n2 \xD7 9 = 18\r\n3 \xD7 6 = 18\r\n\r\nSetiap
    perkalian memperlihatkan dua faktor sekaligus. Pasangan 6 \xD7 3 tidak menghasilkan
    faktor baru karena hanya membalik urutan pasangan 3 \xD7 6.\r\n\r\nJadi, faktor
    dari 18 adalah 1, 2, 3, 6, 9, dan 18."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 139f41658187fe8468598371f870f595, type: 2}
  m_sharedMaterial: {fileID: 3673575472737202838, guid: 139f41658187fe8468598371f870f595, type: 2}
