  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Perhatikan tabel bilangan 1\u201336 yang telah diberi tanda.\n\n\n\n\n\n\n\n\n\n\r\n\r\nAngka
    12 memiliki lingkaran dan garis bawah karena 4 \xD7 3 = 12 dan 6 \xD7 2 = 12.\r\n\r\nAngka
    24 dan 36 juga memiliki kedua tanda. Artinya, masing-masing bilangan tersebut
    merupakan kelipatan 4 sekaligus kelipatan 6.\r\n\r\nJadi, kelipatan persekutuan
    dari 4 dan 6 yang terdapat pada tabel adalah 12, 24, dan 36."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 139f41658187fe8468598371f870f595, type: 2}
  m_sharedMaterial: {fileID: 3673575472737202838, guid: 139f41658187fe8468598371f870f595, type: 2}
