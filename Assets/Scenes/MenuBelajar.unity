  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Jumlah vas terbanyak yang diperoleh adalah 6. Tentukan isi setiap vas
    dengan membagi jumlah bunga menurut warnanya.\r\n\r\nMawar merah:\r\n24 \xF7
    6 = 4 tangkai per vas.\r\n\r\nMawar putih:\r\n18 \xF7 6 = 3 tangkai per vas.\r\n\r\nPeriksa
    dengan perkalian:\r\n6 \xD7 4 = 24 mawar merah.\r\n6 \xD7 3 = 18 mawar putih.\r\n\r\nSeluruh
    bunga terbagi tanpa sisa. Jadi, setiap vas berisi 4 tangkai mawar merah dan 3
    tangkai mawar putih."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 139f41658187fe8468598371f870f595, type: 2}
  m_sharedMaterial: {fileID: 3673575472737202838, guid: 139f41658187fe8468598371f870f595, type: 2}
