  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Dari tabel pembagian berulang bilangan 10 dan 15, pembagi prima yang digunakan
    adalah 2, 3, dan 5.\r\n\r\nUntuk KPK, kalikan semua pembagi prima:\r\nKPK = 2
    \xD7 3 \xD7 5 = 30.\r\n\r\nUntuk FPB, kalikan hanya pembagi yang membagi kedua
    bilangan pada langkah yang sama. Pembagi 2 hanya membagi 10, pembagi 3 hanya
    membagi 15, sedangkan pembagi 5 membagi keduanya.\r\n\r\nJadi, KPK dari 10 dan
    15 adalah 30, sedangkan FPB-nya 5. Periksa: 30 habis dibagi 10 dan 15, sedangkan
    5 dapat membagi keduanya tanpa sisa."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 139f41658187fe8468598371f870f595, type: 2}
  m_sharedMaterial: {fileID: 3673575472737202838, guid: 139f41658187fe8468598371f870f595, type: 2}
