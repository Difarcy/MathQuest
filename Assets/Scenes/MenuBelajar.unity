  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "POHON FAKTOR\r\n\r\nPohon faktor adalah diagram bercabang untuk menguraikan
    suatu bilangan menjadi perkalian faktor-faktor prima.\r\n\r\nContoh: Pohon faktor
    dari 36.\r\n\r\nPilih dua bilangan yang hasil perkaliannya 36:\r\n36 = 6 \xD7
    6\r\n\r\nPada setiap percabangan, hasil perkalian kedua cabang harus sama dengan
    bilangan asalnya. Karena 6 belum prima, kedua cabang 6 masih harus diuraikan.
    Percabangan berhenti ketika semua ujungnya prima."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 139f41658187fe8468598371f870f595, type: 2}
  m_sharedMaterial: {fileID: 3673575472737202838, guid: 139f41658187fe8468598371f870f595, type: 2}
