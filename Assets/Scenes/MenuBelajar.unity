  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "CARA MENENTUKAN FPB\r\n\r\nTuliskan faktor setiap bilangan, lalu pilih
    faktor persekutuan yang paling besar.\r\n\r\nContoh: Tentukan FPB dari 20 dan
    30!\r\n\r\nFaktor 20: 1, 2, 4, 5, 10, 20\r\nFaktor 30: 1, 2, 3, 5, 6, 10, 15,
    30\r\n\r\nFaktor yang sama adalah 1, 2, 5, dan 10. Bilangan 10 merupakan faktor
    yang paling besar. Pemeriksaannya: 20 \xF7 10 = 2 dan 30 \xF7 10 = 3, keduanya
    tanpa sisa.\r\n\r\nJadi, FPB dari 20 dan 30 adalah 10."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 139f41658187fe8468598371f870f595, type: 2}
  m_sharedMaterial: {fileID: 3673575472737202838, guid: 139f41658187fe8468598371f870f595, type: 2}
