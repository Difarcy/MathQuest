  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "MENANDAI KELIPATAN PERSEKUTUAN\r\n\r\nKelipatan persekutuan juga dapat
    ditemukan dengan memberi tanda pada tabel bilangan.\r\n\r\nContoh: Cari kelipatan
    persekutuan dari 4 dan 6 pada tabel 1\u201336.\r\n\r\nKelipatan 4: 4, 8, 12,
    16, 20, 24, 28, 32, 36.\r\nKelipatan 6: 6, 12, 18, 24, 30, 36.\r\n\r\n1. Lingkari
    kelipatan 4 dengan warna biru.\r\n2. Garisbawahi kelipatan 6 dengan warna kuning.\r\n3.
    Cari bilangan yang memiliki kedua tanda.\r\n\r\nBilangan dengan dua tanda itulah
    kelipatan persekutuan."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 139f41658187fe8468598371f870f595, type: 2}
  m_sharedMaterial: {fileID: 3673575472737202838, guid: 139f41658187fe8468598371f870f595, type: 2}
