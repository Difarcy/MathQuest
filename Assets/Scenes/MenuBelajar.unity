  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "MEMERIKSA FAKTOR PERSEKUTUAN\r\n\r\nFaktor persekutuan adalah bilangan
    yang dapat membagi habis dua bilangan atau lebih.\r\n\r\nContoh: Apakah 6 dan
    8 merupakan faktor persekutuan dari 24 dan 36?\r\n\r\nPeriksa 6:\r\n24 \xF7 6
    = 4\r\n36 \xF7 6 = 6\r\n\r\nKeduanya habis dibagi 6. Jadi, 6 merupakan faktor
    persekutuan.\r\n\r\nPeriksa 8:\r\n24 \xF7 8 = 3\r\n36 \xF7 8 = 4 sisa 4\r\n\r\nKarena
    36 tidak habis dibagi 8, maka 8 bukan faktor persekutuan."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 139f41658187fe8468598371f870f595, type: 2}
