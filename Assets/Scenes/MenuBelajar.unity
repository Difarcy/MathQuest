  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "KPK DARI TIGA BILANGAN\r\n\r\nKPK dari tiga bilangan juga dapat ditentukan
    dengan faktorisasi prima.\r\n\r\nContoh: KPK dari 12, 18, dan 24.\r\n\r\n12 =
    2\xB2 \xD7 3\r\n18 = 2 \xD7 3\xB2\r\n24 = 2\xB3 \xD7 3\r\n\r\nPangkat terbesar
    faktor 2 adalah 3, sedangkan pangkat terbesar faktor 3 adalah 2.\r\n\r\nKPK =
    2\xB3 \xD7 3\xB2\r\nKPK = 8 \xD7 9 = 72\r\n\r\nHasilnya habis dibagi ketiganya:
    72 \xF7 12 = 6, 72 \xF7 18 = 4, dan 72 \xF7 24 = 3.\r\n\r\nJadi, KPK dari 12,
    18, dan 24 adalah 72."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 139f41658187fe8468598371f870f595, type: 2}
  m_sharedMaterial: {fileID: 3673575472737202838, guid: 139f41658187fe8468598371f870f595, type: 2}
