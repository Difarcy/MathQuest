  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "MENENTUKAN KELIPATAN BILANGAN\r\n\r\nKelipatan dapat ditentukan dengan
    mengalikan suatu bilangan dengan 1, 2, 3, dan seterusnya secara berurutan.\r\n\r\nContoh:
    Tentukan lima kelipatan pertama dari 7!\r\n\r\n7 \xD7 1 = 7\r\n7 \xD7 2 = 14\r\n7
    \xD7 3 = 21\r\n7 \xD7 4 = 28\r\n7 \xD7 5 = 35\r\n\r\nPengali 1 menghasilkan kelipatan
    pertama, pengali 2 menghasilkan kelipatan kedua, dan seterusnya hingga pengali
    5.\r\n\r\nJadi, lima kelipatan pertama dari 7 adalah 7, 14, 21, 28, dan 35."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 139f41658187fe8468598371f870f595, type: 2}
  m_sharedMaterial: {fileID: 3673575472737202838, guid: 139f41658187fe8468598371f870f595, type: 2}
