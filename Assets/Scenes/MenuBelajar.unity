  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "PENGERTIAN FPB (FAKTOR PERSEKUTUAN TERBESAR)\r\n\r\nFPB adalah faktor
    persekutuan terbesar dari dua bilangan atau lebih.\r\n\r\nContoh: Tentukan FPB
    dari 12 dan 18.\r\n\r\nFaktor persekutuan 12 dan 18 adalah 1, 2, 3, dan 6. Dari
    faktor-faktor tersebut, bilangan 6 paling besar.\r\n\r\nPeriksa:\r\n12 \xF7 6
    = 2\r\n18 \xF7 6 = 3\r\n\r\nKedua bilangan habis dibagi 6. Karena tidak ada faktor
    persekutuan yang lebih besar daripada 6, FPB dari 12 dan 18 adalah 6."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 139f41658187fe8468598371f870f595, type: 2}
  m_sharedMaterial: {fileID: 3673575472737202838, guid: 139f41658187fe8468598371f870f595, type: 2}
