  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "PENGERTIAN KELIPATAN BILANGAN\r\n\r\nKelipatan suatu bilangan adalah hasil
    perkalian bilangan tersebut dengan bilangan asli 1, 2, 3, dan seterusnya.\r\n\r\nContoh:
    Terdapat beberapa kelompok apel. Setiap kelompok berisi 3 apel.\r\n\r\n1 kelompok
    = 1 \xD7 3 = 3 apel\r\n2 kelompok = 2 \xD7 3 = 6 apel\r\n3 kelompok = 3 \xD7
    3 = 9 apel\r\n4 kelompok = 4 \xD7 3 = 12 apel\r\n\r\nSetiap penambahan satu kelompok
    menambah jumlah apel sebanyak 3. Karena itu, jumlah apel membentuk urutan 3,
    6, 9, 12, dan seterusnya.\r\n\r\nJadi, 3, 6, 9, 12, ... merupakan kelipatan 3."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 139f41658187fe8468598371f870f595, type: 2}
  m_sharedMaterial: {fileID: 3673575472737202838, guid: 139f41658187fe8468598371f870f595, type: 2}
  m_fontSharedMaterials: []
  m_fontMaterial: {fileID: 0}
  m_fontMaterials: []
