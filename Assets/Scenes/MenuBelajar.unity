  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Perhatikan hasil penyaringan pada tabel angka 1\u2013100.\n\n\n\n\n\n\n\n\n\n\n\n\r\n\r\nAngka
    1 dicoret. Bilangan yang lebih dari 1 dan tidak tercoret merupakan bilangan prima,
    seperti 2, 3, 5, 7, 11, dan 13.\r\nUntuk bilangan sampai 100, penyaringan hingga
    7 sudah cukup. Bilangan prima berikutnya adalah 11, sedangkan 11 \xD7 11 = 121
    lebih besar dari 100.\r\nDengan demikian, semua bilangan bukan prima telah tersaring.
    Terdapat 25 bilangan prima dari 1 sampai 100."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 139f41658187fe8468598371f870f595, type: 2}
  m_sharedMaterial: {fileID: 3673575472737202838, guid: 139f41658187fe8468598371f870f595, type: 2}
  m_fontSharedMaterials: []
  m_fontMaterial: {fileID: 0}
